{
  "name": "extensions-hub",
  "displayName": "Extensions Hub: All-in-One Micro-Extension Suite",
  "version": "1.0.0",
  "description": "A modular extensions launcher featuring YouTube Music Switcher, Font Finder, Color Picker, and Website Dark Mode Forcer.",
  "author": "shridmishra <shridmishra00@gmail.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "node --test tests/*.test.ts",
    "test:colors": "node --test tests/color-detector.test.ts",
    "validate": "node --test tests/*.test.ts && plasmo build",
    "create:extension": "node scripts/create-extension.mjs"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.4",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "tabs",
      "scripting",
      "activeTab"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "action": {}
  }
}
